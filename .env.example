# PostgreSQL — set this for the deployed instance.
# Local development falls back to SQLite when DATABASE_URL is absent.
DATABASE_URL=postgresql://user:password@host:5432/clinic_booking

# Required in production; any long random string.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# 0 in production.
DJANGO_DEBUG=0

# Comma-separated hosts allowed to serve the app (append your public host).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# The key grader/client requests must present in X-API-Key.
CLINIC_API_KEY=clinic-demo-key

# Level 5 knobs (defaults match the spec: 5 attempts / rolling 60s).
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TTL_HOURS=24
